# Copy to .env and fill in. Never commit .env.

# --- HubSpot private app (Settings → Integrations → Private Apps → your app) ---
# Access token — invoice read/write, files, deals, contacts, notes scopes. One token per portal.
HS_TOKEN=pat-na1-...
# Auth tab → "Show secret". Every webhook HubSpot sends is signed with this; unsigned requests are rejected.
HS_CLIENT_SECRET=

# --- Webhook server ---
# The Target URL exactly as typed into the private app's Webhooks tab (it is part of the signature).
# Production: https://<your-service>/hubspot/webhook   Local: the tunnel URL + /hubspot/webhook
WEBHOOK_URL=https://example.com/hubspot/webhook
PORT=8080

# --- Triggers ---
# true  = generate the moment an invoice is finalised (status → Open), and on Branded PDF = Generate
# false = only Branded PDF = Generate
AUTO_ON_FINALISE=true
# The reconcile search never auto-generates invoices created before this date. Set to the go-live date.
AUTO_SINCE=2026-09-16
# Safety-net search interval in ms (default 10 min ≈ 150 calls/day). 0 disables it.
RECONCILE_MS=600000

# --- Local testing only ---
# ALLOW_UNSIGNED_WEBHOOKS=1   skips the signature check (never in production)

# Path to the standalone invoice template.
TEMPLATE=./invoice-template.html
